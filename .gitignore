__pycache__/
*.py[oc]
.venv/
.env
.DS_Store
models/
node_modules/
out/
/janus/dist/
*.log
# 에이전트 파일 도구의 작업 폴더 — 산출물, 커밋 안 함
/janus_server/janus_server/workspace/
# 실행 기록 — 로컬 산출물, 커밋 안 함
/janus_server/janus_server/runs/
# 벤치마크 산출물은 로컬 진단용이다. v1 감사(scripts/audit_v1.py)가 실제로 읽는
# 4개만 추적한다 — 한때 이 디렉터리가 추적 파일의 46%(216/446)를 차지했고 그중
# 54개에 개인 홈 경로가 박혀 있었다. 새 실행이 그 상태로 되돌아가지 않게 한다.
/janus_server/artifacts/**
!/janus_server/artifacts/p0/
!/janus_server/artifacts/p0/smoke/
!/janus_server/artifacts/p0/smoke/20260822-125259/
!/janus_server/artifacts/p0/smoke/20260822-125259/result.json
!/janus_server/artifacts/p0/tasksuite/
!/janus_server/artifacts/p0/tasksuite/20260822-115844/
!/janus_server/artifacts/p0/tasksuite/20260822-115844/result.json
!/janus_server/artifacts/r3/
!/janus_server/artifacts/r3/tasksuite/
!/janus_server/artifacts/r3/tasksuite/20260822-183500/
!/janus_server/artifacts/r3/tasksuite/20260822-183500/result.json
!/janus_server/artifacts/r3/tasksuite/20260822-p2-final-fixed-one-v2/
!/janus_server/artifacts/r3/tasksuite/20260822-p2-final-fixed-one-v2/result.json
/.serena/
# 로컬 에이전트 도구 상태 — 기여자 머신마다 다르다.
/.claude/
# QA용 일회성 저장소 — 자체 git 저장소이고 버려도 되는 산출물이다.
/janus-qa-fixture/

# 로컬 벤치마크/상태 산출물 — 커밋하지 않는다
/forgeboard-janus-state/
/forgeboard-benchmark/
